---
import Base from '../layouts/Base.astro';
---

<Base title="学習データ" description="このブラウザーに保存した学習記録のバックアップと復元。" wide>
  <section class="section">
    <div class="section__heading"><h1>学習データ</h1><span class="section__subtitle">LEARNING DATA</span></div>
    <p>進捗・ブックマーク・お気に入り・メモ・表示設定は、このブラウザーに保存されます。</p>
    <p>別の端末や新しいサイトURLへ移すときは、元のブラウザーでバックアップを保存し、移行先で読み込んでください。</p>
    <div class="data-actions">
      <button type="button" class="btn btn--ghost" data-export>学習データをバックアップ</button>
      <label class="btn btn--ghost">バックアップを読み込む<input type="file" accept=".json,application/json" data-import hidden /></label>
    </div>
    <p data-data-status role="status" aria-live="polite"></p>
    <p><a href="/progress">進捗を見る</a> ・ <a href="/journal">学習ジャーナル</a></p>
  </section>
  <script is:inline>
    (function () {
      const status = document.querySelector('[data-data-status]');
      const show = text => { if (status) status.textContent = text; };
      document.querySelector('[data-export]')?.addEventListener('click', () => {
        try {
          const payload = window.HirakuLocal.exportData();
          const url = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }));
          const link = document.createElement('a');
          link.href = url;
          link.download = 'hiraku-backup-' + new Date().toISOString().slice(0, 10) + '.json';
          document.body.appendChild(link);
          link.click();
          link.remove();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          show('バックアップを保存しました。');
        } catch (_) { show('バックアップを作成できませんでした。'); }
      });
      document.querySelector('[data-import]')?.addEventListener('change', async event => {
        const file = event.target.files?.[0];
        if (!file) return;
        try {
          if (file.size > 10 * 1024 * 1024) throw new Error('File too large');
          const payload = JSON.parse(await file.text());
          if (!confirm('バックアップに含まれる学習データで、このブラウザーの記録を上書きします。続けますか？')) return;
          window.HirakuLocal.importData(payload);
          show('学習データを復元しました。');
        } catch (_) { show('読み込めませんでした。ひらくのバックアップファイルと保存領域を確認してください。'); }
        finally { event.target.value = ''; }
      });
    })();
  </script>
  <style>.data-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1.5rem 0; } .data-actions label { cursor: pointer; }</style>
</Base>
